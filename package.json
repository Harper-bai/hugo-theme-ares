{
  "name": "hugo-theme-ares",
  "version": "1.0.0",
  "private": true,
  "description": "A faithful Hugo port of Hexo Theme Ares. Node is only needed for optional Sass development.",
  "scripts": {
    "dev": "hugo server --source exampleSite",
    "build": "hugo --source exampleSite --minify",
    "check": "python3 scripts/verify.py",
    "css": "sass --no-source-map assets/scss/ares.scss static/css/ares.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Harper-bai/hugo-theme-ares"
  },
  "author": "Harper-bai; original design by Cytrogen",
  "license": "MIT",
  "devDependencies": {
    "sass": "1.83.0"
  }
}
